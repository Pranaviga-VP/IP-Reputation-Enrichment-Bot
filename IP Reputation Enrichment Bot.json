    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst abuse = (items[0] && items[0].json && items[0].json.data) || {};\nconst vt = (items[1] && items[1].json && items[1].json.data && items[1].json.data.attributes) || {};\nconst source = $('Extract IP').first().json;\n\nconst compact = {\n  abuseipdb: {\n    abuseConfidenceScore: abuse.abuseConfidenceScore,\n    totalReports: abuse.totalReports,\n    countryCode: abuse.countryCode,\n    isp: abuse.isp,\n    usageType: abuse.usageType,\n    isTor: abuse.isTor,\n    lastReportedAt: abuse.lastReportedAt,\n  },\n  virustotal: {\n    reputation: vt.reputation,\n    asOwner: vt.as_owner,\n    country: vt.country,\n    network: vt.network,\n    analysisStats: vt.last_analysis_stats,\n  },\n};\n\nconst redact = (text) => String(text)\n  .replace(/Bearer\\s+[A-Za-z0-9._~+\\/=-]+/gi, 'Bearer [REDACTED]')\n  .replace(/(\"?(?:api[_-]?key|x-apikey|key|token|secret|password|authorization)\"?\\s*[:=]\\s*)\"?[^\",\\s}&]+\"?/gi, '$1\"[REDACTED]\"')\n  .replace(/\\b[A-Fa-f0-9]{40,}\\b/g, '[REDACTED]')\n  .replace(/\\b\\d{8,10}:[A-Za-z0-9_-]{30,}\\b/g, '[REDACTED]');\n\nreturn [{\n  json: {\n    ip: source.ip,\n    chatId: source.chatId,\n    abuseScore: abuse.abuseConfidenceScore === undefined ? 'n/a' : abuse.abuseConfidenceScore,\n    vtMalicious: vt.last_analysis_stats && vt.last_analysis_stats.malicious !== undefined ? vt.last_analysis_stats.malicious : 'n/a',\n    enrichment: redact(JSON.stringify(compact)),\n  },\n}];"
      },
      "id": "59d3c86a-b361-491a-b467-24ee7237e2e3",
